class Mouse
{
    public int weight;
    public int eyeCount = 2;
    public char[] pedigree = new char[4];
    private char firstInitial = 'z';
    private int age;

    Mouse(int age, char[] initials, int weight)
    {
        this.age = age;
        this.weight = weight;
        Initialize(initials);
    }

    private void Initialize(char[] initials)
    {
        this.pedigree = intials;
        this.firstInitial = initials[0];
    }

    public char[] GetPedigreeReversed()
    {
        int i = 3;
        char[] result = new char[4];
        while (i >= 0)
        {
            result[3 - i] = this.pedigree[i];
            i = i +-1; // Overly complicated to test number sign.
        }
    }
}

